<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Revv.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Revv"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentRed">#E8001D</Color>
            <Color x:Key="AccentRedDim">#7A0010</Color>
            <Color x:Key="ThrottleBlue">#00A8FF</Color>
            <Color x:Key="HorizonAmber">#FF9500</Color>
            <Color x:Key="Surface">#141414</Color>
            <Color x:Key="SurfaceHigh">#1F1F1F</Color>
            <Color x:Key="SurfaceBorder">#2A2A2A</Color>
            <Color x:Key="TextPrimary">#F0F0F0</Color>
            <Color x:Key="TextMuted">#555555</Color>
            <Color x:Key="ConnectedGreen">#00E87A</Color>

            <Style x:Key="LabelMono" TargetType="Label">
                <Setter Property="FontFamily" Value="RobotoMono" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="SliderStyle" TargetType="Slider">
                <Setter Property="MinimumTrackColor" Value="{StaticResource AccentRed}" />
                <Setter Property="MaximumTrackColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Outer Grid stacks children — content grid first, then the
        cluster frame overlay drawn on top (InputTransparent so
        touches fall through to the content beneath).
    -->
    <Grid Padding="0">

        <Grid RowDefinitions="Auto,Auto,*" Padding="0">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ROW 0 — Top bar                                         -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid
            Grid.Row="0"
            Padding="20,12,12,8"
            ColumnSpacing="12">

                <Frame
                Grid.Column="1"
                Padding="10,4"
                BackgroundColor="{StaticResource Surface}"
                BorderColor="{StaticResource SurfaceBorder}"
                CornerRadius="12"
                 Margin="0,12,0,0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                    <StackLayout Orientation="Horizontal" Spacing="7">
                        <Ellipse
                        x:Name="StatusDot"
                        Fill="{StaticResource TextMuted}"
                        HeightRequest="7"
                        VerticalOptions="Center"
                        WidthRequest="7" />
                        <Label
                        x:Name="StatusLabel"
                        FontSize="10"
                        Style="{StaticResource LabelMono}"
                        Text="SEARCHING..."
                        TextColor="{StaticResource TextMuted}"
                        VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

                <Grid
                x:Name="PedalsToggle"
                Grid.Column="2"
                HeightRequest="28"
                HorizontalOptions="End"
                Margin="0,12,72,0"
                VerticalOptions="Center"
                WidthRequest="56">

                    <Border
                    x:Name="PedalsTrack"
                    BackgroundColor="{StaticResource SurfaceHigh}"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource SurfaceBorder}"
                    VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                    x:Name="PedalsThumb"
                    BackgroundColor="{StaticResource TextMuted}"
                    HeightRequest="28"
                    HorizontalOptions="Start"
                    InputTransparent="True"
                    Margin="2,0,0,0"
                    Padding="5"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Image
                        Source="pedals_icon.svg"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
                    </Border>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedalsToggled" />
                    </Grid.GestureRecognizers>
                </Grid>

                <ImageButton
                    x:Name="SettingsButton"
                    Grid.Column="3"
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    Clicked="OnSettingsToggled"
                    HorizontalOptions="Start"
                    Margin="56,20,0,0"
                    HeightRequest="26"
                    Source="settings.png"
                    VerticalOptions="Center"
                    WidthRequest="26" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ROW 1 — Settings panel (collapsed by default)           -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Frame
            x:Name="SettingsPanel"
            Grid.Row="1"
            Padding="20,12"
            BackgroundColor="{StaticResource Surface}"
            BorderColor="{StaticResource SurfaceBorder}"
            CornerRadius="0"
            IsVisible="False">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="24">

                    <StackLayout Grid.Column="0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                            Grid.Column="0"
                            FontSize="10"
                            Style="{StaticResource LabelMono}"
                            Text="SENSITIVITY"
                            TextColor="{StaticResource TextMuted}" />
                            <Label
                            x:Name="SensitivityValueLabel"
                            Grid.Column="1"
                            FontSize="10"
                            Style="{StaticResource LabelMono}"
                            Text="1.0"
                            TextColor="{StaticResource AccentRed}" />
                        </Grid>
                        <Slider
                        x:Name="SensitivitySlider"
                        Maximum="3.0"
                        Minimum="0.1"
                        Style="{StaticResource SliderStyle}"
                        Value="1.0"
                        ValueChanged="OnSensitivityChanged" />
                    </StackLayout>

                    <StackLayout Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                            Grid.Column="0"
                            FontSize="10"
                            Style="{StaticResource LabelMono}"
                            Text="RANGE"
                            TextColor="{StaticResource TextMuted}" />
                            <Label
                            x:Name="RangeValueLabel"
                            Grid.Column="1"
                            FontSize="10"
                            Style="{StaticResource LabelMono}"
                            Text="45°"
                            TextColor="{StaticResource AccentRed}" />
                        </Grid>
                        <Slider
                        x:Name="RangeSlider"
                        Maximum="90"
                        Minimum="15"
                        Style="{StaticResource SliderStyle}"
                        Value="45"
                        ValueChanged="OnRangeChanged" />
                    </StackLayout>

                    <Button
                    x:Name="RecenterButton"
                    Grid.Column="2"
                    Padding="16,0"
                    BackgroundColor="{StaticResource SurfaceHigh}"
                    BorderColor="{StaticResource AccentRed}"
                    BorderWidth="1"
                    Clicked="OnRecenterClicked"
                    CornerRadius="6"
                    FontAttributes="Bold"
                    FontSize="10"
                    Text="RECENTER"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ROW 2 — Driving area + stats bar                        -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto" >

                <!-- Sub-row 0: [Brake | Horizon | Throttle] -->
                <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto,*"
                IsClippedToBounds="True">

                    <!-- ─────────────────────────────────────────────── -->
                    <!-- BRAKE PANEL                                      -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid
                    x:Name="BrakePanel"
                    Grid.Column="0"
                    IsClippedToBounds="True"
                    IsVisible="False"
                    WidthRequest="100"
                    HorizontalOptions="Center"
                    RowDefinitions="1*,8*,1*">
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer
                            PointerPressed="OnBrakePressed"
                            PointerReleased="OnBrakeReleased" />
                        </Grid.GestureRecognizers>

                        <local:PedalSKView
                        x:Name="BrakePedalView"
                        Grid.Row="1"
                        HorizontalOptions="Fill"
                        InputTransparent="True"
                        VerticalOptions="Fill"
                        Margin="0,0,0,24"/>
                    </Grid>

                    <!-- ─────────────────────────────────────────────── -->
                    <!-- CENTER — SkiaSharp Attitude Indicator            -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid Grid.Column="1" IsClippedToBounds="True">

                        <VerticalStackLayout
                        HorizontalOptions="Fill"
                        Spacing="8"
                        VerticalOptions="Center">

                            <local:AttitudeSKView
                            x:Name="AttitudeView"
                            HeightRequest="270"
                            HorizontalOptions="Center"
                            InputTransparent="True"
                            WidthRequest="270" />

                            <!-- Angle readout below circle -->
                            <Label
                            x:Name="AngleLabel"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Style="{StaticResource LabelMono}"
                            Text=" 0.000"
                            TextColor="{StaticResource TextMuted}" />

                            <Label
                            FontSize="9"
                            HorizontalOptions="Center"
                            Style="{StaticResource LabelMono}"
                            Text="DOUBLE-TAP TO RECENTER"
                            TextColor="#333333" />
                        </VerticalStackLayout>

                        <!-- Full-area double-tap target -->
                        <Grid x:Name="TapTarget">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                NumberOfTapsRequired="2"
                                Tapped="OnDoubleTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>

                    <!-- ─────────────────────────────────────────────── -->
                    <!-- THROTTLE PANEL                                   -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid
                    x:Name="ThrottlePanel"
                    Grid.Column="2"
                    IsClippedToBounds="True"
                    IsVisible="False"
                    WidthRequest="100"
                    RowDefinitions="1*,8*,1*">
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer
                            PointerPressed="OnThrottlePressed"
                            PointerReleased="OnThrottleReleased" />
                        </Grid.GestureRecognizers>

                        <local:PedalSKView
                            x:Name="ThrottlePedalView"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            InputTransparent="True"
                            Type="{x:Static local:PedalType.Throttle}"
                            Margin="0,0,0,24"
                            VerticalOptions="Fill" />
                    </Grid>
                    <!-- Battery -->
                    <local:BatterySKView
                         x:Name="BatteryGauge"
                         WidthRequest="80"
                         Grid.ColumnSpan="2"
                         HorizontalOptions="Center"
                         Margin="-12,0,0,38"
                         InputTransparent="True"
                         VerticalOptions="Start"/>

                    <!-- Signal -->
                    <local:WifiSKView
                         x:Name="WifiView"
                         HeightRequest="48"
                         WidthRequest="48"
                         Grid.ColumnSpan="2"
                         Margin="8,0,0,22"
                         HorizontalOptions="End"
                         InputTransparent="True"
                         VerticalOptions="End" />

                    <!-- Latency -->
                    <StackLayout
                         Grid.Column="0"
                         HorizontalOptions="End"
                         Orientation="Vertical"
                         Spacing="2"
                         VerticalOptions="Start">
                            <Label
                             x:Name="LatencyValue"
                             FontSize="14"
                             HorizontalOptions="Center"
                             Style="{StaticResource LabelMono}"
                             Text="—"
                             TextColor="{StaticResource TextMuted}" />
                            <Label
                             FontSize="8"
                             HorizontalOptions="Center"
                             Style="{StaticResource LabelMono}"
                             Text="LATENCY"
                             TextColor="{StaticResource TextMuted}" />
                        </StackLayout>

                </Grid>

            </Grid>

        </Grid>
        <!-- end inner content Grid -->

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Cluster frame overlay — SkiaSharp, drawn on top         -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <local:ClusterFrameSKView
            HorizontalOptions="Fill"
            InputTransparent="True"
            VerticalOptions="Fill"/>

    </Grid>
    <!-- end outer overlay Grid -->
</ContentPage>
