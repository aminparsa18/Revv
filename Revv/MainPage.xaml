<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Revv.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Revv.Controls"
    xmlns:tour="clr-namespace:MarketAlly.SpotlightTour.Maui;assembly=MarketAlly.SpotlightTour.Maui"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentRed">#E8001D</Color>
            <Color x:Key="AccentRedDim">#7A0010</Color>
            <Color x:Key="ThrottleBlue">#00A8FF</Color>
            <Color x:Key="HorizonAmber">#FF9500</Color>
            <Color x:Key="Surface">#141414</Color>
            <Color x:Key="SurfaceHigh">#1F1F1F</Color>
            <Color x:Key="SurfaceBorder">#2A2A2A</Color>
            <Color x:Key="TextPrimary">#F0F0F0</Color>
            <Color x:Key="TextMuted">#555555</Color>
            <Color x:Key="ConnectedGreen">#00E87A</Color>

            <Style x:Key="LabelMono" TargetType="Label">
                <Setter Property="FontFamily" Value="RobotoMono" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="SliderStyle" TargetType="Slider">
                <Setter Property="MinimumTrackColor" Value="{StaticResource AccentRed}" />
                <Setter Property="MaximumTrackColor" Value="{StaticResource SurfaceHigh}" />
                <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Outer Grid stacks children — content grid first, then the
        cluster frame overlay drawn on top (InputTransparent so
        touches fall through to the content beneath).
    -->
    <Grid Padding="0" ColumnDefinitions="*,*">
      

        <Grid RowDefinitions="Auto,*" Padding="0" Grid.ColumnSpan="2">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ROW 0 — Top bar                                         -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid
            Grid.Row="0"
            Padding="20,12,12,8"
            ColumnSpacing="12">

                <Border
                x:Name="StatusBorder"
                Grid.Column="1"
                Padding="10,4"
                BackgroundColor="{StaticResource Surface}"
                Margin="0,12,0,0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeThickness="1"
                Stroke="{StaticResource SurfaceBorder}"
                tour:Onboarding.StepKey="status"
                tour:Onboarding.Title="CONNECTION STATUS"
                tour:Onboarding.Description="REVV broadcasts over Wi-Fi. The pill turns green when your PC app finds this phone — no manual IP entry needed."
                tour:Onboarding.Order="1"
                tour:Onboarding.SpotlightShape="RoundedRectangle"
                tour:Onboarding.SpotlightCornerRadius="12"
                tour:Onboarding.SpotlightPadding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="7">
                        <Ellipse
                        x:Name="StatusDot"
                        Fill="{StaticResource TextMuted}"
                        HeightRequest="7"
                        VerticalOptions="Center"
                        WidthRequest="7" />
                        <Label
                        x:Name="StatusLabel"
                        FontSize="10"
                        Style="{StaticResource LabelMono}"
                        Text="SEARCHING..."
                        TextColor="{StaticResource TextMuted}"
                        VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Grid
                x:Name="PedalsToggle"
                Grid.Column="2"
                HeightRequest="28"
                HorizontalOptions="End"
                Margin="0,12,72,0"
                VerticalOptions="Center"
                WidthRequest="56"
                tour:Onboarding.StepKey="pedals"
                tour:Onboarding.Title="PEDAL MODE"
                tour:Onboarding.Description="Swap joysticks for brake and throttle. Tap-and-hold either pedal at full travel — release to zero."
                tour:Onboarding.Order="4"
                tour:Onboarding.SpotlightShape="RoundedRectangle"
                tour:Onboarding.SpotlightCornerRadius="14"
                tour:Onboarding.SpotlightPadding="6">

                    <Border
                    x:Name="PedalsTrack"
                    BackgroundColor="{StaticResource SurfaceHigh}"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource SurfaceBorder}"
                    VerticalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                    x:Name="PedalsThumb"
                    BackgroundColor="{StaticResource TextMuted}"
                    HeightRequest="28"
                    HorizontalOptions="Start"
                    InputTransparent="True"
                    Margin="2,0,0,0"
                    Padding="5"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Image
                        Source="pedals_icon.svg"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
                    </Border>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPedalsToggled" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid
                    Grid.Column="3"
                    Margin="56,20,0,0"
                    ColumnSpacing="14"
                    ColumnDefinitions="*,*"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <ImageButton
                        x:Name="SettingsButton"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        Clicked="OnSettingsToggled"
                        HeightRequest="22"
                        Source="settings.png"
                        VerticalOptions="Center"
                        WidthRequest="22"
                        tour:Onboarding.StepKey="settings"
                        tour:Onboarding.Title="TUNING"
                        tour:Onboarding.Description="Dial in sensitivity, steering range, dead zone, and auto-center spring strength."
                        tour:Onboarding.Order="5"
                        tour:Onboarding.SpotlightShape="Circle"
                        tour:Onboarding.SpotlightPadding="12" />
                    <ImageButton
                         x:Name="PauseButton"
                         Grid.Column="1"
                         Padding="0,6,0,0"
                         BackgroundColor="Transparent"
                         BorderColor="Transparent"
                         Clicked="OnPauseClicked"
                         HeightRequest="20"
                         Source="pause.svg"
                         VerticalOptions="Center"
                         WidthRequest="20" />   
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ROW 1 — Driving area / Settings panel (swap on toggle)  -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">

                  

                <!-- Driving area — visible by default -->
            <Grid x:Name="DrivingArea" RowDefinitions="*,Auto" >

                    <!-- Sub-row 0: [Brake | Horizon | Throttle] -->
                <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto,*"
                IsClippedToBounds="True">

                        <!-- ─────────────────────────────────────────────── -->
                    <!-- LEFT STICK JOYSTICK — default game mode control  -->
                    <!-- ─────────────────────────────────────────────── -->
                        <controls:JoystickSKView
                            x:Name="LeftJoystickView"
                            Grid.Column="0"
                            WidthRequest="130"
                            HeightRequest="130"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            ValueChanged="OnLeftJoystickChanged" />

                        <!-- ─────────────────────────────────────────────── -->
                    <!-- BRAKE PANEL                                      -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid
                    x:Name="BrakePanel"
                    Grid.Column="0"
                    IsClippedToBounds="True"
                    IsVisible="False"
                    WidthRequest="100"
                    HorizontalOptions="Center"
                    RowDefinitions="1*,8*,1*">
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer
                            PointerPressed="OnBrakePressed"
                            PointerReleased="OnBrakeReleased" />
                        </Grid.GestureRecognizers>

                      <controls:PedalSKView
                        x:Name="BrakePedalView"
                        Grid.Row="1"
                        HorizontalOptions="Fill"
                        InputTransparent="True"
                        VerticalOptions="Fill"
                        Margin="0,0,0,24"/>
                    </Grid>
                       
                        <!-- ─────────────────────────────────────────────── -->
                    <!-- CENTER — SkiaSharp Attitude Indicator            -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid x:Name="AttitudePanel" Grid.Column="1" IsClippedToBounds="True">

                        <VerticalStackLayout
                        HorizontalOptions="Fill"
                        Spacing="8"
                        VerticalOptions="Center">

                         <controls:AttitudeSKView
                            x:Name="AttitudeView"
                            HeightRequest="240"
                            HorizontalOptions="Center"
                            InputTransparent="True"
                            WidthRequest="240"
                            tour:Onboarding.StepKey="steering"
                            tour:Onboarding.Title="TILT TO STEER"
                            tour:Onboarding.Description="Rotate your phone like a steering wheel. The gyroscope drives Left Stick X on the virtual gamepad — no per-game setup needed."
                            tour:Onboarding.Order="2"
                            tour:Onboarding.SpotlightShape="Circle"
                            tour:Onboarding.SpotlightPadding="10" />

                            <!-- Angle readout below circle -->
                            <Label
                            x:Name="AngleLabel"
                            FontSize="14"
                            HorizontalOptions="Center"
                            Style="{StaticResource LabelMono}"
                            Text=" 0.000"
                            TextColor="{StaticResource TextMuted}" />

                            <Label
                            FontSize="9"
                            HorizontalOptions="Center"
                            Style="{StaticResource LabelMono}"
                            Text="DOUBLE-TAP TO RECENTER"
                            TextColor="#333333" />
                        </VerticalStackLayout>

                        <!-- Full-area double-tap target -->
                        <Grid x:Name="TapTarget">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                NumberOfTapsRequired="2"
                                Tapped="OnDoubleTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>

                        <controls:FaceButtonsSKView
                            x:Name="FaceButtons"
                            WidthRequest="94"
                            HeightRequest="94"
                            VerticalOptions="Start"
                            Grid.Column="2"
                            Margin="-14,0,12,12"
                            HorizontalOptions="Start"
                            ButtonPressed="OnFaceButtonPressed"
                            ButtonReleased="OnFaceButtonReleased" />

                        <controls:RecenterSKView
                            x:Name="RecenterButton"
                            Grid.Column="2"
                            Margin="16,32,0,6"
                            HeightRequest="48"
                            WidthRequest="48"
                            HorizontalOptions="Start"
                            Clicked="OnRecenterClicked"
                            tour:Onboarding.StepKey="recenter"
                            tour:Onboarding.Title="RECENTER"
                            tour:Onboarding.Description="Snaps the steering angle to zero. Also works with a double-tap anywhere on the attitude indicator."
                            tour:Onboarding.Order="3"
                            tour:Onboarding.SpotlightShape="Circle"
                            tour:Onboarding.SpotlightPadding="10" />

                        <!-- ─────────────────────────────────────────────── -->
                        <!-- RIGHT STICK JOYSTICK — default game mode control -->
                        <!-- ─────────────────────────────────────────────── -->
                        <controls:JoystickSKView
                            x:Name="JoystickView"
                            Grid.Column="2"
                            WidthRequest="130"
                            HeightRequest="130"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            ValueChanged="OnJoystickChanged" />  

                        <!-- Settings panel — full-screen column, hidden by default -->
                        <Grid  Grid.Column="1"
                               x:Name="SettingsPanel"
                               IsVisible="False"
                               Padding="32,0"
                               IsClippedToBounds="True"
                               WidthRequest="240"
                               VerticalOptions="Start">

                            <VerticalStackLayout
                               Spacing="6"
                               VerticalOptions="Center">

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Label
                           Grid.Column="0"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="SENSITIVITY"
                           TextColor="{StaticResource TextMuted}" />
                                        <Label
                           x:Name="SensitivityValueLabel"
                           Grid.Column="1"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="1.0"
                           TextColor="{StaticResource AccentRed}" />
                                        <controls:HelpSKView
                           Grid.Column="2"
                           Clicked="OnSensitivityHelp"
                           HeightRequest="16"
                           Margin="6,0,0,0"
                           VerticalOptions="Center"
                           WidthRequest="16" />
                                    </Grid>
                                    <Slider
                       x:Name="SensitivitySlider"
                       Maximum="3.0"
                       Minimum="0.1"
                       Style="{StaticResource SliderStyle}"
                       Value="1.0"
                       ValueChanged="OnSensitivityChanged" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Label
                           Grid.Column="0"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="RANGE"
                           TextColor="{StaticResource TextMuted}" />
                                        <Label
                           x:Name="RangeValueLabel"
                           Grid.Column="1"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="45°"
                           TextColor="{StaticResource AccentRed}" />
                                        <controls:HelpSKView
                           Grid.Column="2"
                           Clicked="OnRangeHelp"
                           HeightRequest="16"
                           Margin="6,0,0,0"
                           VerticalOptions="Center"
                           WidthRequest="16" />
                                    </Grid>
                                    <Slider
                       x:Name="RangeSlider"
                       Maximum="90"
                       Minimum="15"
                       Style="{StaticResource SliderStyle}"
                       Value="45"
                       ValueChanged="OnRangeChanged" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Label
                           Grid.Column="0"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="DEAD ZONE"
                           TextColor="{StaticResource TextMuted}" />
                                        <Label
                           x:Name="DeadZoneValueLabel"
                           Grid.Column="1"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="0.5°"
                           TextColor="{StaticResource AccentRed}" />
                                        <controls:HelpSKView
                           Grid.Column="2"
                           Clicked="OnDeadZoneHelp"
                           HeightRequest="16"
                           Margin="6,0,0,0"
                           VerticalOptions="Center"
                           WidthRequest="16" />
                                    </Grid>
                                    <Slider
                       x:Name="DeadZoneSlider"
                       Maximum="5.0"
                       Minimum="0.0"
                       Style="{StaticResource SliderStyle}"
                       Value="0.5"
                       ValueChanged="OnDeadZoneChanged" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Label
                           Grid.Column="0"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="AUTO-CENTER"
                           TextColor="{StaticResource TextMuted}" />
                                        <Label
                           x:Name="CenterAssistValueLabel"
                           Grid.Column="1"
                           FontSize="11"
                           Style="{StaticResource LabelMono}"
                           Text="2%"
                           TextColor="{StaticResource AccentRed}" />
                                        <controls:HelpSKView
                           Grid.Column="2"
                           Clicked="OnCenterAssistHelp"
                           HeightRequest="16"
                           Margin="6,0,0,0"
                           VerticalOptions="Center"
                           WidthRequest="16" />
                                    </Grid>
                                    <Slider
                       x:Name="CenterAssistSlider"
                       Maximum="10"
                       Minimum="0"
                       Style="{StaticResource SliderStyle}"
                       Value="2"
                       ValueChanged="OnCenterAssistChanged" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>

                            <!-- Tooltip popover — fades in over slider content on ? tap -->
                            <Border
                                x:Name="TooltipBorder"
                                BackgroundColor="#1C1C1C"
                                HorizontalOptions="Fill"
                                IsVisible="False"
                                Margin="0,8"
                                Padding="14,10"
                                Stroke="{StaticResource SurfaceBorder}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    x:Name="TooltipLabel"
                                    FontSize="11"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelMono}"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTooltipDismissed" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    
                        <!-- ─────────────────────────────────────────────── -->
                    <!-- THROTTLE PANEL                                   -->
                    <!-- ─────────────────────────────────────────────── -->
                    <Grid
                    x:Name="ThrottlePanel"
                    Grid.Column="2"
                    IsClippedToBounds="True"
                    IsVisible="False"
                    WidthRequest="100"
                    RowDefinitions="1*,8*,1*">
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer
                            PointerPressed="OnThrottlePressed"
                            PointerReleased="OnThrottleReleased" />
                        </Grid.GestureRecognizers>

                       <controls:PedalSKView
                            x:Name="ThrottlePedalView"
                            Grid.Row="1"
                            HorizontalOptions="Fill"
                            InputTransparent="True"
                            Type="{x:Static controls:PedalType.Throttle}"
                            Margin="0,0,0,24"
                            VerticalOptions="Fill" />
                    </Grid>
                    <!-- Battery -->
                    <controls:BatterySKView
                         x:Name="BatteryGauge"
                         WidthRequest="80"
                         Grid.ColumnSpan="2"
                         HorizontalOptions="Center"
                         Margin="-12,0,0,38"
                         InputTransparent="True"
                         VerticalOptions="Start"/>

 

                        <!-- Signal -->
                    <controls:WifiSKView
                         x:Name="WifiView"
                         HeightRequest="48"
                         WidthRequest="48"
                         Grid.ColumnSpan="2"
                         Margin="8,0,0,22"
                         HorizontalOptions="End"
                         InputTransparent="True"
                         VerticalOptions="End" />

                    <!-- Latency -->
                    <VerticalStackLayout
                         Grid.Column="0"
                         HorizontalOptions="End"
                         Spacing="2"
                         VerticalOptions="Start">
                            <Label
                             x:Name="LatencyValue"
                             FontSize="14"
                             HorizontalOptions="Center"
                             Style="{StaticResource LabelMono}"
                             Text="—"
                             TextColor="{StaticResource TextMuted}" />
                            <Label
                             FontSize="8"
                             HorizontalOptions="Center"
                             Style="{StaticResource LabelMono}"
                             Text="LATENCY"
                             TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                </Grid>

            </Grid>
            <!-- end DrivingArea -->

            </Grid>
            <!-- end Row 1 swap container -->

        </Grid>
        <!-- end inner content Grid -->

        <!-- ─────────────────────────────────────────────── -->
        <!-- SPEED GAUGE (rumble-derived)                     -->
        <!-- ─────────────────────────────────────────────── -->
        <!--<local:SpeedSKView
       x:Name="SpeedGauge"
       Grid.Column="1"
       WidthRequest="150"
       HeightRequest="150"
       Margin="42,0,0,16"
       HorizontalOptions="Start"
       InputTransparent="True"
       VerticalOptions="End" />-->
        
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Cluster frame overlay — SkiaSharp, drawn on top         -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <controls:ClusterFrameSKView
            Grid.ColumnSpan="2"
            HorizontalOptions="Fill"
            InputTransparent="True"
            VerticalOptions="Fill"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- First-time tour overlay — must be last child to be on top -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <tour:OnboardingHost
            x:Name="TourHost"
            Grid.ColumnSpan="2"
            Theme="Dark"
            DimOpacity="0.85"
            DimColor="Black"
            CalloutPositionMode="AutoCorner"
            ShowCornerNavigator="True"
            CornerNavigatorPlacement="Auto"
            ShowSkipButton="True"
            AnimationsEnabled="True">

            <tour:OnboardingHost.IntroView>
                <Border
                    BackgroundColor="#141414"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="32,36"
                    Stroke="#2A2A2A"
                    StrokeThickness="1"
                    WidthRequest="290">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="20">
                        <Label
                            Text="REVV"
                            FontFamily="RobotoMono"
                            FontSize="40"
                            FontAttributes="Bold"
                            TextColor="#E8001D"
                            HorizontalOptions="Center" />
                        <Label
                            Text="QUICK TOUR"
                            FontFamily="RobotoMono"
                            FontSize="11"
                            TextColor="#555555"
                            HorizontalOptions="Center"
                            CharacterSpacing="3" />
                        <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" />
                        <Label
                            Text="5 steps. Less than a minute."
                            FontFamily="RobotoMono"
                            FontSize="13"
                            TextColor="#F0F0F0"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="LET'S GO"
                            BackgroundColor="#E8001D"
                            TextColor="#F0F0F0"
                            FontFamily="RobotoMono"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="44"
                            Clicked="OnTourIntroStart" />
                        <Button
                            Text="SKIP"
                            BackgroundColor="Transparent"
                            TextColor="#555555"
                            FontFamily="RobotoMono"
                            FontSize="11"
                            CornerRadius="8"
                            HeightRequest="36"
                            BorderColor="#2A2A2A"
                            BorderWidth="1"
                            Clicked="OnTourIntroSkip" />
                    </VerticalStackLayout>
                </Border>
            </tour:OnboardingHost.IntroView>

        </tour:OnboardingHost>

    </Grid>
    <!-- end outer overlay Grid -->
</ContentPage>
